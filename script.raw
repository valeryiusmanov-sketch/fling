local flingBtn = Instance.new("TextButton")
flingBtn.Size = UDim2.new(0.4, 0, 0, 30)
flingBtn.Position = UDim2.new(0.3, 0, 0.7, 0)
flingBtn.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
flingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
flingBtn.Text = "💥 ФЛИНГ"
flingBtn.TextScaled = true
flingBtn.Font = Enum.Font.GothamBold
flingBtn.BorderSizePixel = 0
flingBtn.Parent = mainFrame
Instance.new("UICorner", flingBtn).CornerRadius = UDim.new(0, 6)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 20)
status.Position = UDim2.new(0, 0, 0.85, 0)
status.BackgroundTransparency = 1
status.Text = "Введи ники через запятую"
status.TextColor3 = Color3.fromRGB(200, 200, 200)
status.TextScaled = true
status.Font = Enum.Font.Gotham
status.Parent = mainFrame

-- =============================================
-- ФУНКЦИЯ ФЛИНГА
-- =============================================
local function flingByNames(inputText)
    if not inputText or inputText == "" then
        status.Text = "❌ Введи ники!"
        status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local names = parseNames(inputText)
    if #names == 0 then
        status.Text = "❌ Ники не найдены"
        status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local foundPlayers = {}
    local notFound = {}
    
    for _, name in ipairs(names) do
        local target = Players:FindFirstChild(name)
        if target and target ~= p then
            table.insert(foundPlayers, target)
        else
            table.insert(notFound, name)
        end
    end
    
    if #foundPlayers == 0 then
        status.Text = "❌ Никто не найден: " .. table.concat(notFound, ", ")
        status.TextColor3 = Color3.fromRGB(255, 100, 100)
        return
    end
    
    local statusText = "💥 Флингую: "
    for _, plr in ipairs(foundPlayers) do
        statusText = statusText .. plr.Name .. ", "
        pcall(function()
            kawasakiFling(plr)
        end)
        task.wait(0.2)
    end
    statusText = statusText:sub(1, -3) .. " ✅"
    status.Text = statusText
    status.TextColor3 = Color3.fromRGB(0, 255, 100)
    
    if #notFound > 0 then
        status.Text = status.Text .. " (не найдены: " .. table.concat(notFound, ", ") .. ")"
    end
end

-- =============================================
-- ОБРАБОТЧИКИ
-- =============================================
flingBtn.MouseButton1Click:Connect(function()
    flingByNames(input.Text)
end)

input.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        flingByNames(input.Text)
    end
end)

print("🔪 Fling GUI загружен!")
